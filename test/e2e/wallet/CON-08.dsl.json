{
  "version": "0.2",
  "steps": [
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "assert_exists", "predicate": { "text_contains": "搜索服务" }, "timeout_ms": 8000 },
    { "action": "tap", "predicate": { "text_contains": "我的", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "tap", "predicate": { "text_contains": "切换到卖家模式", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 4000 },
    { "action": "tap", "predicate": { "text_contains": "钱包", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 5000 },
    { "action": "tap", "predicate": { "text_contains": "绑定收款账户", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 6000 },
    { "action": "assert_exists", "predicate": { "text_contains": "银行账号已绑定" }, "timeout_ms": 8000 },
    { "action": "assert_exists", "predicate": { "text_contains": "刷新状态" }, "timeout_ms": 5000 },
    { "action": "tap", "predicate": { "text_contains": "刷新状态", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 5000 },
    {
      "action": "ai_assert",
      "assert_prompt": "点击刷新状态后页面出现加载中（CircularProgressIndicator）或状态已重新检查（仍显示审核中或变更为已激活状态）",
      "timeout_ms": 8000
    },
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "observe", "include": ["ui_tree"] }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
