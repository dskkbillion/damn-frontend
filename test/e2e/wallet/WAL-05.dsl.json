{
  "version": "0.2",
  "steps": [
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "assert_exists", "predicate": { "text_contains": "搜索服务" }, "timeout_ms": 8000 },
    { "action": "tap", "predicate": { "text_contains": "我的", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "tap", "predicate": { "text_contains": "切换到卖家模式", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 4000 },
    { "action": "tap", "predicate": { "text_contains": "钱包", "index": 0 } },
    { "action": "wait_for", "stable": true, "timeout_ms": 8000 },
    {
      "action": "ai_assert",
      "assert_prompt": "页面显示错误状态：存在错误提示文本（包含[错误]或[失败]或[occurred]）以及[重试]按钮，而非正常的账户余额卡片",
      "timeout_ms": 8000
    },
    { "action": "assert_exists", "predicate": { "text_contains": "重试" }, "timeout_ms": 5000 },
    { "action": "wait_for", "stable": true, "timeout_ms": 3000 },
    { "action": "observe", "include": ["ui_tree"] }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
