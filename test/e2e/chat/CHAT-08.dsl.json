{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "聊聊", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "聊天列表" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "通知中心" },
      "timeout_ms": 5000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "聊天列表中至少有一个会话项，会话项右上角有未读消息数角标（红色数字圆点），或列表中显示有未读消息数",
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "输入消息..." },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "button", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "聊天列表" },
      "timeout_ms": 8000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "返回聊天列表后，刚才进入的会话未读角标已清零（角标消失或变为0），已知DEE-72缺陷：若角标未清零属预期内的已知问题",
      "timeout_ms": 5000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
