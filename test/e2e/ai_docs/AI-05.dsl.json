{
  "version": "0.2",
  "_note": "partial — 推荐卡片内容依赖后端返回真实推荐数据；price 格式为「￥XX.XX」；需 AI-04 路径成功打开底部弹窗后才能执行本 case；blocker 同 AI-04",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "看看", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "欢迎使用AI助手" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "input" },
      "timeout_ms": 6000
    },
    {
      "action": "type",
      "text": "我需要找一个设计服务",
      "predicate": { "type": "input" },
      "clear_first": true
    },
    {
      "action": "tap",
      "predicate": { "type": "button", "near": { "type": "input" }, "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "我需要找一个设计服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "匹配" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 6000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "推荐服务" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image", "index": 0 },
      "timeout_ms": 6000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "￥" },
      "timeout_ms": 6000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "底部弹窗「推荐服务」中显示商品卡片，每张卡片包含商品图片、标题文字、以￥开头的价格",
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
