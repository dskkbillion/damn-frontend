{
  "version": "0.2",
  "_note": "partial — 依赖 AI-08 前置（横幅 remaining≤5 时才显示）；关闭按钮是横幅右侧 Icons.close（InkWell onDismiss）；_isRateLimitWarningDismissed 设为 true 后横幅变 SizedBox.shrink；blocker 同 AI-08",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "看看", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 6000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "欢迎使用AI助手" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "今日剩余次数" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "今日剩余次数", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_not_exists",
      "predicate": { "text_contains": "今日剩余次数" },
      "timeout_ms": 5000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
