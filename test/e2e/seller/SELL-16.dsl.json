      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "已下架", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
