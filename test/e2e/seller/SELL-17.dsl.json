{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "切换到买家模式" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "商品", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "已下架" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "已下架", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "上架" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "删除" },
      "timeout_ms": 5000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "已下架商品卡片的操作按钮区域只显示「上架」和「删除」两个按钮，不存在「编辑」按钮"
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
