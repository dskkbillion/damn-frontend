{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "收入" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "切换到买家模式" },
      "timeout_ms": 5000
    },
    {
      "action": "wait_for",
      "predicate": { "text_contains": "总收入" },
      "timeout_ms": 8000
    },
    {
      "action": "scroll",
      "direction": "down",
      "amount": 50
    },
    {
      "action": "scroll",
      "direction": "up",
      "amount": 300
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "收入" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "总收入" },
      "timeout_ms": 5000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
