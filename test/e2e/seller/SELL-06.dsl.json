{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "切换到买家模式" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "商品", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "在售" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "在售", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "编辑" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "编辑", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "Basic" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "textfield", "index": 0 }
    },
    {
      "action": "type",
      "text": " 已编辑"
    },
    {
      "action": "scroll",
      "direction": "down",
      "amount": 500
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "发布" },
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "发布", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
