{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "我的订单" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的订单", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "全部" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "待评价", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "去评价", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "评价订单" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "input" },
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "type": "input", "index": 0 }
    },
    {
      "action": "type",
      "text": "商品质量很好，卖家服务也很专业，非常满意！",
      "predicate": { "type": "input", "index": 0 },
      "clear_first": true
    },
    {
      "action": "swipe",
      "direction": "up",
      "distance": 200
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 2000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "提交评价" },
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "提交评价", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 6000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
