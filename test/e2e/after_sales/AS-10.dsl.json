{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "我的订单" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的订单", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "全部" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "售后中", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "售后列表页显示至少一条售后记录，列表项含状态标签（如 Pending Review / Approved / After-Sales Application Rejected / Refund Successful / Canceled）",
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "After-sales Details" },
      "timeout_ms": 8000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "售后详情页顶部状态卡片显示当前状态标题，如 Pending Review、Approved、After-Sales Application Rejected、Refund Successful 或 Canceled 之一，并有对应的副标题说明文字",
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
