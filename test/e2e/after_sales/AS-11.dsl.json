{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "我的订单" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "我的订单", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "全部" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "售后中", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "After-sales Details" },
      "timeout_ms": 8000
    },
    {
      "action": "swipe",
      "direction": "up",
      "distance": 400
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 2000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "Revoke Application" },
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "Revoke Application", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 8000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "撤销申请操作已触发：页面状态变为 Canceled，或出现撤销成功的提示，或跳转到售后列表",
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
