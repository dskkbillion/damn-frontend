{
  "version": "0.2",
  "steps": [
    {
      "action": "open_app",
      "bundle_id": "com.duoshaokankan.weapp",
      "fresh": true
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 4000
    },
    {
      "action": "if_exists",
      "predicate": { "text_contains": "获取验证码" },
      "then": [
        {
          "action": "tap",
          "predicate": { "text_contains": "手机号" }
        },
        {
          "action": "wait_for",
          "stable": true,
          "timeout_ms": 2000
        },
        {
          "action": "type",
          "text": "18888888888",
          "predicate": { "type": "input", "index": 0 },
          "clear_first": true
        },
        {
          "action": "tap",
          "predicate": { "text_contains": "获取验证码" }
        },
        {
          "action": "wait_for",
          "stable": true,
          "timeout_ms": 3000
        },
        {
          "action": "type",
          "text": "565656",
          "predicate": { "type": "input", "index": 1 },
          "clear_first": true
        },
        {
          "action": "tap",
          "predicate": { "text": "登录" }
        },
        {
          "action": "wait_for",
          "predicate": { "text_contains": "搜索服务" },
          "timeout_ms": 10000
        }
      ],
      "else": []
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image", "text_contains": "$" },
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
