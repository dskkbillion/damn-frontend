{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "搜索服务" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "type",
      "text": "服务",
      "predicate": { "type": "input" },
      "clear_first": true
    },
    {
      "action": "tap",
      "predicate": { "text": "搜索" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image", "text_contains": "$" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "text_contains": "$", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "已发布" },
      "timeout_ms": 8000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "查看全部" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "查看全部" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "评论" },
      "timeout_ms": 8000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "评价列表页已打开，页面标题或内容区包含评价相关文字（如评论、评价、套餐名或用户昵称等）"
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
