{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "predicate": { "type": "image", "text_contains": "$" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "type": "image", "text_contains": "$", "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "已发布" },
      "timeout_ms": 8000
    },
    {
      "action": "swipe",
      "from_coords": { "x": 300, "y": 63 },
      "to_coords": { "x": 80, "y": 63 },
      "duration_ms": 400
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 2000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "一键购买" },
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "已发布" },
      "timeout_ms": 3000
    },
    {
      "action": "ai_assert",
      "assert_prompt": "当前是商品详情页，顶部展示商品图片，页面在滑动后正常未崩溃"
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
