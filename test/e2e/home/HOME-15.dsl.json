{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "搜索服务" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 4000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "input" },
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索历史" },
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "热搜榜" },
      "timeout_ms": 5000
    },
    {
      "action": "tap",
      "predicate": { "type": "button", "near": { "text_contains": "搜索历史" }, "index": 0 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
