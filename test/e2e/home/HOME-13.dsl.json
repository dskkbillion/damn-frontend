{
  "version": "0.2",
  "_case": "HOME-13",
  "_fix": "2026-07-07 修复：staging 当前「服务」/「设计」关键词可返回空结果，改用已实测有结果的 scallioncake；搜索按钮可能因自动搜索提前消失，改为可选点击。",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "_note": "用坐标 tap 搜索框中心点，避免 Other 容器穿透跳 tab",
      "action": "tap",
      "coords": { "x": 201, "y": 90 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "type",
      "text": "scallioncake",
      "predicate": { "type": "input" },
      "clear_first": true
    },
    {
      "action": "if_exists",
      "predicate": { "text": "搜索" },
      "then": [
        {
          "action": "tap",
          "predicate": { "text": "搜索" }
        }
      ]
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image", "text_contains": "$" },
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
