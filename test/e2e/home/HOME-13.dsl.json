{
  "version": "0.2",
  "_case": "HOME-13",
  "_fix": "2026-06-22 修复：tap {text_contains:搜索服务} 会命中 Other 容器导致跳「我的」tab，改用坐标 (201,90) 直接点搜索框。",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "_note": "用坐标 tap 搜索框中心点，避免 Other 容器穿透跳 tab",
      "action": "tap",
      "coords": { "x": 201, "y": 90 }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "type",
      "text": "服务",
      "predicate": { "type": "input" },
      "clear_first": true
    },
    {
      "action": "tap",
      "predicate": { "text": "搜索" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 5000
    },
    {
      "action": "assert_exists",
      "predicate": { "type": "image", "text_contains": "$" },
      "timeout_ms": 8000
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
