{
  "version": "0.2",
  "steps": [
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "搜索服务" },
      "timeout_ms": 8000
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "搜索服务" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "type",
      "text": "zzzzzzqqq",
      "predicate": { "type": "input" },
      "clear_first": true
    },
    {
      "action": "tap",
      "predicate": { "text": "搜索" }
    },
    {
      "action": "wait_for",
      "predicate": { "text_contains": "没有找到相关的服务" },
      "timeout_ms": 6000
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "没有找到相关的服务" },
      "timeout_ms": 3000
    },
    {
      "action": "assert_not_exists",
      "predicate": { "type": "image", "text_contains": "$" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
