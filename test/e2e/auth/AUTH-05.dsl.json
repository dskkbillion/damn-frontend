{
  "version": "0.2",
  "steps": [
    {
      "action": "open_app",
      "bundle_id": "com.duoshaokankan.weapp",
      "fresh": true
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 4000
    },
    {
      "action": "if_exists",
      "predicate": { "text_contains": "获取验证码" },
      "then": [],
      "else": [
        {
          "action": "tap",
          "predicate": { "text_contains": "我的" }
        },
        {
          "action": "wait_for",
          "stable": true,
          "timeout_ms": 3000
        },
        {
          "action": "scroll",
          "direction": "down",
          "to_element": { "predicate": { "text_contains": "账号与安全" } },
          "max_scrolls": 8
        },
        {
          "action": "tap",
          "predicate": { "text_contains": "账号与安全" }
        },
        {
          "action": "wait_for",
          "predicate": { "text_contains": "退出登录" },
          "timeout_ms": 5000
        },
        {
          "action": "tap",
          "predicate": { "text_contains": "退出登录" }
        },
        {
          "action": "wait_for",
          "predicate": { "text": "确定" },
          "timeout_ms": 3000
        },
        {
          "action": "tap",
          "predicate": { "text": "确定" }
        },
        {
          "action": "wait_for",
          "predicate": { "text_contains": "获取验证码" },
          "timeout_ms": 8000
        }
      ]
    },
    {
      "action": "type",
      "text": "test",
      "predicate": { "type": "input", "index": 0 },
      "clear_first": true
    },
    {
      "action": "tap",
      "predicate": { "text_contains": "获取验证码" }
    },
    {
      "action": "assert_exists",
      "predicate": { "text_contains": "请输入有效的邮箱地址" },
      "timeout_ms": 4000
    },
    {
      "action": "assert_not_exists",
      "predicate": { "text_contains": "登录成功!" }
    },
    {
      "action": "wait_for",
      "stable": true,
      "timeout_ms": 3000
    },
    {
      "action": "observe",
      "include": ["ui_tree"]
    }
  ],
  "on_fail": { "strategy": "retry", "max_retries": 2 }
}
