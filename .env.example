################################################################################
# Environment Configuration File
# Copy this file to .env and fill in your actual values
################################################################################

#===============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# The application will not start without these variables properly configured
#===============================================================================

# Backend API base URL (REQUIRED)
# This is the main API server endpoint for all backend operations
# Examples:
#   Production: https://app.duoshaokankan.com/prod-api
#   Development: http://localhost:8080
BACKEND_BASE_URL=

# AI Model service base URL (REQUIRED)
# This is the endpoint for AI/ML model services
# Example: http://your-model-server.com:5107
MODEL_BASE_URL=

#===============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# These enhance functionality but are not required for basic operation
#===============================================================================

# WeChat App ID (Optional - Required for WeChat login/payment features)
# Obtain from WeChat Open Platform
WECHAT_APP_ID=

# WeChat Universal Link (Optional - Required for WeChat on iOS)
# Must match your iOS app configuration
# Default example (update with your domain): https://app.duoshaokankan.com/wechat/
WECHAT_UNIVERSAL_LINK=

# Alipay App ID (Optional - Required for Alipay payment features)
# Obtain from Alipay Open Platform
# Example: 2021000000000000
ALIPAY_APP_ID=

# International API URL (Optional)
# Used for international version of the app
# If not set, will use BACKEND_BASE_URL
INTERNATIONAL_API_URL=

# International Model Service URL (Optional)
# Used for international version's AI services
# If not set, will use MODEL_BASE_URL
INTERNATIONAL_MODEL_URL=

# WebSocket Base URL (Optional)
# Custom WebSocket endpoint if different from backend
# If not set, will be derived from BACKEND_BASE_URL (http->ws, https->wss)
# Example: wss://your-websocket-server.com
WEBSOCKET_BASE_URL=

# Stripe Publishable Key (Optional - Required for Stripe Connect embedded onboarding)
# Obtain from Stripe Dashboard > API keys
# Use pk_test_* for dev/staging, pk_live_* for production
STRIPE_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (Optional until mobile IAP is enabled).
# These are platform-specific public keys. Never put RevenueCat secret API keys
# in the app. They may also be supplied with --dart-define using the same names.
REVENUECAT_IAP_ENABLED=false
REVENUECAT_OFFERING_ID=credits_v1
REVENUECAT_IOS_PUBLIC_API_KEY=
REVENUECAT_ANDROID_PUBLIC_API_KEY=

#===============================================================================
# NOTES
#===============================================================================
# 1. Never commit the actual .env file to version control
# 2. All URLs should include the protocol (http://, https://, ws://, wss://)
# 3. Do not include trailing slashes in URLs
# 4. For production, always use HTTPS/WSS for security
#===============================================================================
# #370 omni 直接理解音频 (true, 默认) vs 走 ASR 预转录 (false, 回滚用; ASR 计划 2026-06-04 下线)
ENABLE_OMNI_VOICE=true
