{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "components/ai_doc/spinner.js",
    "components/ai_doc/recommendation.js",
    "src/util/veridication.js",
    "components/homepage/itemFeaturesContenttsx",
    "sdk/payment/alipay.js",
    "types/**/*.d.ts"
  ]
}
