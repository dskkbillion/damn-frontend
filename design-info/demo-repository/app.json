{
  "expo": {
    "name": "play_tamagui",
    "slug": "dskkapp",
    "version": "1.0.0",
    "scheme": "play-tamagui",
    "web": {
      "bundler": "webpack",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#B66D0E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "play-tamagui",
      "deploymentTarget": "13.1",
      "runtimeVersion": "1.0.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library.",
        "NSLocalNetworkUsageDescription": "应用需要访问本地网络以连接开发服务器",
        "NSBonjourServices": [
          "_expo._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "runtimeVersion": "1.0.0",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.frankwaang.play_tamagui"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c0fa4f0b-f038-4f8a-8a89-614a632a7a48"
      }
    },
    "owner": "paperblue"
  }
}
